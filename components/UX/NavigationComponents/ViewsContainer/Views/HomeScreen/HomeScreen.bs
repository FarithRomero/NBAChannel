function onKeyEvent(key as String, press as Boolean) as Boolean
	handled = false

	if press
		if key = "OK"
			if m.watchNowButton.isInFocusChain()
				m.watchNowButton.isFocused = true
			end if
        else if key = "down"
            if m.watchNowButton.isInFocusChain()
                m.watchNowButton.isFocused = false
			end if
        else if key = "up"
            if m.top.isInFocusChain()
                m.watchNowButton.setFocus(true)
                m.watchNowButton.isFocused = true
			end if
		end if
		handled = true
	end if
	return handled
end function
